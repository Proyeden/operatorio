function onTipoChange(){
  // auto-set cirugía alto riesgo RCRI
  setChk("rcri_hr",HIRISK.has(val("tipo")));
  calc();
}
function calc(){
  // reflejar autos en checkboxes visibles
  SCORE_ORDER.forEach(name=>{
    const def=SCORES[name];if(!def||!def.items)return;
    def.items.forEach(it=>{
      if(it.auto && autoPts(it.auto)===null){ // binarios
        setChk(it.id,autoState(it.auto));
      }
    });
  });
  // antropometría hint
  const b=imc(),s=sct(),r=rt24(),pk=pesoKg();
  document.getElementById("antropo_hint").textContent=
    (pk!==null?`Peso ${pk.toFixed(1)} kg · `:"")+(b!==null?`IMC ${b.toFixed(1)} · `:"")+
    (s!==null?`SC ${s.toFixed(2)} m² · `:"")+(r!==null?`Req 24h ${Math.round(r)} ml`:"");
  // score badges/totales/interp
  SCORE_ORDER.forEach(name=>{
    const tot=document.getElementById("tot_"+name);
    if(tot)tot.textContent=scoreDisplay(name);
    const bd=document.getElementById("badge_"+name);
    if(bd){const rel=relevance(name);
      bd.textContent=rel==="P"?"⭐ Prioritario":(rel==="N"?"No aplica":"Opcional");
      bd.className="badge "+(rel==="P"?"b-pri":(rel==="N"?"b-na":"b-opt"));}
    const ip=document.getElementById("interp_"+name);
    if(ip)ip.textContent=interp(name);
  });
  if(presetMode!=="custom")applyPreset();
  render();
}

function esc(s){return (s||"").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");}
function orDash(s){s=(s||"").trim();return s?esc(s):"—";}

function suggestions(){
  const out=[];
  if(dasiMets()<4)out.push("Capacidad funcional <4 METs: valorar pruebas cardíacas (ecocardiograma/prueba de estrés) si modifican la conducta.");
  if(scoreTotal("RCRI")>=2)out.push("RCRI elevado: optimización cardiológica, considerar biomarcadores (BNP/troponina) y monitoreo cardíaco.");
  const at=scoreTotal("ARISCAT");
  if(at>=45)out.push("ARISCAT alto: espirometría incentiva, ventilación protectora y monitoreo respiratorio postoperatorio.");
  else if(at>=26)out.push("ARISCAT intermedio: técnicas de expansión pulmonar y movilización temprana.");
  const ct=scoreTotal("Caprini");
  if(ct>=3)out.push("Tromboprofilaxis farmacológica + mecánica (Caprini).");
  else if(ct>=1)out.push("Profilaxis mecánica de TVP (compresión neumática intermitente o medias de compresión graduada).");
  const sb=scoreTotal("STOP-BANG");
  if(sb>=5)out.push("Alto riesgo de SAOS: precaución con opioides, oximetría postoperatoria, considerar CPAP.");
  else if(sb>=3)out.push("Riesgo intermedio de SAOS: vigilancia respiratoria postoperatoria.");
  if(scoreTotal("mFI-5")>=2)out.push("Fragilidad (mFI-5 ≥2): prehabilitación, optimización nutricional y consentimiento reforzado.");
  if(scoreTotal("Apfel")>=3)out.push("Apfel ≥3: profilaxis multimodal de NVPO (2+ antieméticos de distinta clase).");
  if(scoreTotal("Charlson")>=5)out.push("Comorbilidad alta (Charlson ≥5): optimización médica y considerar nivel de cuidados postoperatorios.");
  const r=rt24();if(r!==null)out.push(`Terapia hídrica basal: ${Math.round(r)} ml/24h (Holliday-Segar). Ajustar a pérdidas quirúrgicas y estado clínico.`);
  return out;
}

