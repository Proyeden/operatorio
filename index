<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Valoración Preoperatoria — Cirugía No Cardíaca</title>
<style>
  :root{
    --ink:#16222e; --muted:#5b6b7a; --line:#d9e0e6; --bg:#eef2f5; --card:#fff;
    --primary:#0e6b73; --primary-dark:#0a4f55; --navy:#17324d;
    --priority:#2e7d4f; --priority-bg:#e4f2ea;
    --optional:#b9770e; --optional-bg:#fbf1dd;
    --na:#98a4b0; --na-bg:#eef1f4;
    --low:#2e7d4f; --mid:#c07f12; --high:#c0392b;
    --input:#fffdf5;
  }
  *{box-sizing:border-box}
  html,body{margin:0;padding:0}
  body{font-family:-apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
       color:var(--ink);background:var(--bg);line-height:1.45;font-size:14px}
  /* ---- Top bar ---- */
  header.topbar{position:sticky;top:0;z-index:50;background:var(--primary-dark);
       color:#fff;display:flex;align-items:center;justify-content:space-between;
       padding:10px 18px;box-shadow:0 2px 8px rgba(0,0,0,.15)}
  header.topbar h1{font-size:15px;font-weight:600;margin:0;letter-spacing:.02em;
       display:flex;align-items:center;gap:10px}
  header.topbar h1 .tag{font-weight:400;font-size:11px;background:rgba(255,255,255,.15);
       padding:2px 8px;border-radius:10px}
  .actions{display:flex;gap:8px;flex-wrap:wrap;align-items:center;justify-content:flex-end}
  .status{font-size:11px;color:rgba(255,255,255,.85);font-style:italic;min-width:70px;text-align:right}
  .btn{border:none;border-radius:6px;padding:8px 14px;font-size:13px;font-weight:600;
       cursor:pointer;font-family:inherit;transition:.15s}
  .btn-word{background:#fff;color:var(--primary-dark)}
  .btn-word:hover{background:#e9f3f2}
  .btn-pdf{background:var(--primary);color:#fff}
  .btn-pdf:hover{background:#0c5a61}
  .btn-ghost{background:transparent;color:#fff;border:1px solid rgba(255,255,255,.4)}
  .btn-ghost:hover{background:rgba(255,255,255,.12)}
  /* ---- Layout ---- */
  .wrap{display:grid;grid-template-columns:1fr 1fr;gap:0;align-items:start}
  .form-pane{padding:18px 20px 80px;max-height:calc(100vh - 52px);overflow-y:auto}
  .preview-pane{position:sticky;top:52px;height:calc(100vh - 52px);overflow-y:auto;
       background:#dfe6ec;padding:20px;border-left:1px solid var(--line)}
  @media(max-width:900px){
    .wrap{grid-template-columns:1fr}
    .preview-pane{position:static;height:auto;max-height:none}
    .form-pane{max-height:none;overflow:visible}
  }
  /* ---- Form ---- */
  .card{background:var(--card);border:1px solid var(--line);border-radius:10px;
       margin-bottom:16px;overflow:hidden}
  .card > h2{margin:0;font-size:13px;font-weight:700;letter-spacing:.04em;
       text-transform:uppercase;color:#fff;background:var(--navy);padding:9px 14px;
       display:flex;align-items:center;gap:8px}
  .card-body{padding:12px 14px}
  .grid2{display:grid;grid-template-columns:1fr 1fr;gap:8px 12px}
  .grid3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px 12px}
  @media(max-width:520px){.grid2,.grid3{grid-template-columns:1fr}}
  .field{display:flex;flex-direction:column;gap:3px;margin-bottom:8px}
  .field label{font-size:11px;font-weight:600;color:var(--muted);text-transform:uppercase;
       letter-spacing:.03em}
  .field input,.field select,.field textarea{font-family:inherit;font-size:13px;
       padding:7px 9px;border:1px solid var(--line);border-radius:6px;background:var(--input);
       color:var(--ink);width:100%}
  .field input:focus,.field select:focus,.field textarea:focus{outline:none;
       border-color:var(--primary);box-shadow:0 0 0 2px rgba(14,107,115,.15)}
  .field textarea{resize:vertical;min-height:44px}
  .hint{font-size:11px;color:var(--muted);font-style:italic;margin-top:2px}
  /* ---- Score blocks ---- */
  .score{border:1px solid var(--line);border-radius:8px;margin-bottom:10px;overflow:hidden}
  .score-head{display:flex;align-items:center;justify-content:space-between;gap:8px;
       padding:8px 12px;background:#f4f7f9;cursor:pointer;user-select:none}
  .score-head .stitle{font-weight:700;font-size:13px;display:flex;align-items:center;gap:8px}
  .score-head .chev{color:var(--muted);transition:transform .2s;font-size:11px}
  .score.collapsed .chev{transform:rotate(-90deg)}
  .score.collapsed .score-body{display:none}
  .score-meta{display:flex;align-items:center;gap:6px}
  .score-head .inc{font-size:10px;color:var(--muted);display:flex;align-items:center;gap:3px;
       font-weight:600;text-transform:uppercase;letter-spacing:.02em}
  .score-head .inc input{accent-color:var(--primary);width:14px;height:14px;cursor:pointer}
  .notectrl{padding:8px 14px;border-bottom:1px solid var(--line);display:flex;align-items:center;
       gap:8px;flex-wrap:wrap;background:#f7fafb}
  .notectrl .nclabel{font-size:11px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.03em}
  .notectrl select{font-size:12px;padding:5px 8px;border:1px solid var(--line);border-radius:5px;background:var(--input)}
  .notectrl .nchint{font-size:11px;color:var(--muted);font-style:italic}
  .btn-mini{margin-left:auto;font-size:11px;font-weight:600;border:1px solid var(--line);
       background:#fff;color:var(--primary-dark);border-radius:5px;padding:4px 9px;cursor:pointer}
  .btn-mini:hover{background:#eef6f6}
  /* modal biblioteca */
  .modal-bg{position:fixed;inset:0;background:rgba(20,30,40,.5);z-index:100;display:none;
       align-items:center;justify-content:center;padding:20px}
  .modal-bg.open{display:flex}
  .modal{background:#fff;border-radius:12px;width:min(560px,96vw);max-height:86vh;
       display:flex;flex-direction:column;overflow:hidden;box-shadow:0 12px 40px rgba(0,0,0,.3)}
  .modal-head{background:var(--navy);color:#fff;padding:12px 16px;font-weight:700;font-size:14px;
       display:flex;justify-content:space-between;align-items:center}
  .modal-head button{background:none;border:none;color:#fff;font-size:18px;cursor:pointer;line-height:1}
  .modal-search{margin:12px 16px 8px;padding:8px 10px;border:1px solid var(--line);border-radius:6px;
       font-size:13px;font-family:inherit}
  .modal-list{flex:1;overflow-y:auto;padding:0 16px 8px}
  .lib-row{display:flex;align-items:center;gap:10px;padding:10px 12px;border:1px solid var(--line);
       border-radius:8px;margin-bottom:8px;transition:.12s}
  .lib-row:hover{border-color:var(--primary);background:#f7fafb}
  .lib-info{flex:1;min-width:0}
  .lib-name{font-weight:700;font-size:13px;color:var(--ink)}
  .lib-meta{font-size:11px;color:var(--muted)}
  .lib-actions{display:flex;gap:6px}
  .lib-actions button{font-size:11px;font-weight:600;border:none;border-radius:5px;padding:5px 10px;cursor:pointer}
  .lib-open{background:var(--primary);color:#fff}
  .lib-del{background:#f4e3e3;color:#b23b3b}
  .lib-empty{text-align:center;color:var(--muted);font-style:italic;padding:24px;font-size:13px}
  .modal-foot{border-top:1px solid var(--line);padding:12px 16px;display:flex;gap:8px;flex-wrap:wrap;
       justify-content:flex-end;background:#f7fafb}
  .btn-ghost.dark{color:var(--primary-dark);border:1px solid var(--line);background:#fff}
  .btn-ghost.dark:hover{background:#eef6f6}
  .badge{font-size:10px;font-weight:700;padding:2px 8px;border-radius:10px;white-space:nowrap}
  .b-pri{background:var(--priority-bg);color:var(--priority)}
  .b-opt{background:var(--optional-bg);color:var(--optional)}
  .b-na{background:var(--na-bg);color:var(--na)}
  .score-total{font-size:12px;font-weight:700;background:var(--navy);color:#fff;
       padding:2px 9px;border-radius:10px;min-width:34px;text-align:center}
  .score-body{padding:8px 12px 12px}
  .score-interp{font-size:12px;color:var(--primary-dark);background:#eef6f6;
       border-left:3px solid var(--primary);padding:6px 9px;border-radius:0 5px 5px 0;margin-top:8px}
  .check{display:flex;align-items:flex-start;gap:8px;padding:4px 0;font-size:13px;cursor:pointer}
  .check input{margin-top:2px;accent-color:var(--primary);width:15px;height:15px;flex:0 0 auto}
  .check .pts{margin-left:auto;font-size:11px;color:var(--muted);font-weight:600;
       background:#eef1f4;padding:0 6px;border-radius:8px}
  .check.auto{opacity:.75}
  .check.auto input{pointer-events:none}
  .autoflag{font-size:9px;background:#e4eef0;color:var(--primary);padding:1px 5px;
       border-radius:6px;font-weight:700;margin-left:4px}
  .rowsel{display:flex;gap:8px;align-items:center;margin-bottom:6px}
  .rowsel label{font-size:12px;font-weight:600;color:var(--muted);flex:0 0 auto}
  .rowsel select{flex:1;font-size:12px;padding:5px 7px;border:1px solid var(--line);
       border-radius:5px;background:var(--input)}
  /* ---- Recs ---- */
  .rec-item{display:flex;align-items:flex-start;gap:8px;padding:3px 0;font-size:12.5px;cursor:pointer}
  .rec-item input{margin-top:2px;accent-color:var(--primary)}
  .rec-suggest{font-size:12px;background:#eef6f6;border-left:3px solid var(--primary);
       padding:5px 9px;border-radius:0 5px 5px 0;margin:3px 0;color:var(--primary-dark)}
  /* ---- Note preview ---- */
  .note{background:#fff;max-width:720px;margin:0 auto;padding:34px 40px;
       box-shadow:0 3px 14px rgba(0,0,0,.12);border-radius:3px;font-size:12.5px;color:#1a1a1a}
  .note h1{font-size:17px;text-align:center;background:var(--navy);color:#fff;
       margin:-34px -40px 0;padding:14px;letter-spacing:.03em}
  .note .frame{font-size:10.5px;font-style:italic;color:#555;background:#fbf3dc;
       padding:8px 12px;margin:0 -40px 16px;border-bottom:1px solid #eadcbb}
  .note h2{font-size:12px;text-transform:uppercase;letter-spacing:.05em;color:#fff;
       background:var(--primary);padding:5px 10px;margin:16px 0 8px;border-radius:3px}
  .note table{width:100%;border-collapse:collapse;margin:4px 0}
  .note td{border:1px solid #cfd8de;padding:4px 7px;vertical-align:top;font-size:11.5px}
  .note td.lab{background:#f2f5f7;font-weight:600;width:26%}
  .note td.lab-sm{background:#f2f5f7;font-weight:600;font-size:11px}
  .note .risk-tbl td{font-size:11px}
  .note .risk-tbl th{background:#8ea9db;color:#fff;padding:4px 7px;font-size:11px;
       border:1px solid #cfd8de;text-align:left}
  .note .pri{background:#e4f2ea;color:#2e7d4f;font-weight:700;text-align:center}
  .note .opt{color:#7a6a4a;text-align:center;font-weight:600}
  .note .na{background:#eef1f4;color:#9aa4ae;text-align:center;font-style:italic}
  .note .na-row td{color:#b3bcc4}
  .note .algo{padding:9px 11px;border-radius:5px;font-size:11.5px;line-height:1.5}
  .note .algo.low{background:#e4f2ea;color:#2b5e3f}
  .note .algo.high{background:#fbe4d8;color:#8a3b16;font-weight:600}
  .note .recs{white-space:pre-wrap;font-size:11.5px;line-height:1.55;padding:8px 4px}
  .note .sign{margin-top:34px;text-align:center}
  .note .sign .line{border-top:1px solid #333;width:220px;margin:0 auto 4px}
  .note .sign .nm{font-weight:700}
  .note .sign .sm{font-size:10.5px;color:#555}
  .note .muted{color:#777;font-style:italic;font-size:10.5px}
  .preview-label{max-width:720px;margin:0 auto 8px;font-size:11px;color:#5b6b7a;
       text-transform:uppercase;letter-spacing:.05em;font-weight:700}
  /* ---- Print ---- */
  @media print{
    header.topbar,.form-pane,.preview-label{display:none!important}
    .wrap{display:block}
    .preview-pane{position:static;height:auto;overflow:visible;background:#fff;
         padding:0;border:none}
    .note{box-shadow:none;max-width:none;margin:0;padding:20px 24px;border-radius:0}
    .note h1{margin:-20px -24px 0}
    .note .frame{margin:0 -24px 14px}
  }
</style>
</head>
<body>
<header class="topbar">
  <h1>Valoración Preoperatoria <span class="tag">Cirugía no cardíaca</span></h1>
  <div class="actions">
    <span id="status" class="status"></span>
    <button class="btn btn-ghost" onclick="newPatient()">Nuevo</button>
    <button class="btn btn-ghost" onclick="saveToLibrary()">Guardar paciente</button>
    <button class="btn btn-ghost" onclick="openLibraryModal()">Abrir paciente</button>
    <button class="btn btn-pdf" onclick="window.print()">Imprimir / PDF</button>
    <button class="btn btn-word" onclick="downloadWord()">Descargar Word</button>
  </div>
</header>

<div class="wrap">
  <!-- ================= FORM ================= -->
  <div class="form-pane" id="formPane">
    <div class="card"><h2>Datos del paciente</h2><div class="card-body">
      <div class="field"><label>Nombre completo</label><input id="nombre" oninput="render()"></div>
      <div class="grid3">
        <div class="field"><label>Fecha</label><input type="date" id="fecha" oninput="render()"></div>
        <div class="field"><label>Edad (años)</label><input type="number" id="edad" min="0" oninput="calc()"></div>
        <div class="field"><label>Sexo</label><select id="sexo" onchange="calc()"><option value=""></option><option>Femenino</option><option>Masculino</option></select></div>
      </div>
      <div class="grid2">
        <div class="field"><label>Estado civil</label><input id="civil" oninput="render()"></div>
        <div class="field"><label>Religión</label><input id="religion" oninput="render()"></div>
      </div>
    </div></div>

    <div class="card"><h2>Cirugía planeada</h2><div class="card-body">
      <div class="field"><label>Procedimiento</label><input id="proc" oninput="render()"></div>
      <div class="grid2">
        <div class="field"><label>Tipo de cirugía</label><select id="tipo" onchange="onTipoChange()"></select></div>
        <div class="field"><label>Riesgo quirúrgico</label><select id="riesgoq" onchange="calc()">
          <option value="">—</option><option>Bajo (&lt;1%)</option><option>Intermedio (1-5%)</option><option>Alto (&gt;5%)</option>
        </select></div>
      </div>
    </div></div>

    <div class="card"><h2>Antecedentes patológicos</h2><div class="card-body">
      <div class="field"><label>Médicos</label><textarea id="a_med" oninput="render()"></textarea></div>
      <div class="grid2">
        <div class="field"><label>Quirúrgicos</label><textarea id="a_qx" oninput="render()"></textarea></div>
        <div class="field"><label>Traumatológicos</label><textarea id="a_trauma" oninput="render()"></textarea></div>
        <div class="field"><label>Alérgicos</label><textarea id="a_alerg" oninput="render()"></textarea></div>
        <div class="field"><label>Gineco-obstétricos</label><textarea id="a_go" oninput="render()"></textarea></div>
      </div>
      <div class="field"><label>Medicación actual</label><textarea id="a_med_act" oninput="render()"></textarea></div>
    </div></div>

    <div class="card"><h2>Hábitos y estilo de vida</h2><div class="card-body">
      <div class="grid3">
        <div class="field"><label>Ejercicio</label><input id="h_ej" oninput="render()"></div>
        <div class="field"><label>Alcohol</label><input id="h_alc" oninput="render()"></div>
        <div class="field"><label>Tabaco</label><input id="h_tab" oninput="render()"></div>
      </div>
    </div></div>

    <div class="card"><h2>Examen físico</h2><div class="card-body">
      <div class="grid3">
        <div class="field"><label>PA (mmHg)</label><input id="v_pa" oninput="render()"></div>
        <div class="field"><label>FC (lpm)</label><input id="v_fc" oninput="render()"></div>
        <div class="field"><label>FR (rpm)</label><input id="v_fr" oninput="render()"></div>
        <div class="field"><label>Temp (°C)</label><input id="v_temp" oninput="render()"></div>
        <div class="field"><label>SatO₂ (%)</label><input id="v_sat" oninput="render()"></div>
      </div>
      <div class="grid3">
        <div class="field"><label>Peso</label><input type="number" id="peso" oninput="calc()"></div>
        <div class="field"><label>Unidad</label><select id="peso_u" onchange="calc()"><option>lb</option><option>kg</option></select></div>
        <div class="field"><label>Talla (cm)</label><input type="number" id="talla" oninput="calc()"></div>
      </div>
      <div class="hint" id="antropo_hint"></div>
      <div class="field"><label>Estado general</label><textarea id="ef_gen" oninput="render()"></textarea></div>
      <div class="grid2">
        <div class="field"><label>Cabeza y cuello</label><textarea id="ef_cab" oninput="render()"></textarea></div>
        <div class="field"><label>Tórax</label><textarea id="ef_tor" oninput="render()"></textarea></div>
        <div class="field"><label>Abdomen</label><textarea id="ef_abd" oninput="render()"></textarea></div>
        <div class="field"><label>Extremidades</label><textarea id="ef_ext" oninput="render()"></textarea></div>
        <div class="field"><label>Neurológico</label><textarea id="ef_neuro" oninput="render()"></textarea></div>
        <div class="field"><label>Piel y faneras</label><textarea id="ef_piel" oninput="render()"></textarea></div>
      </div>
    </div></div>

    <div class="card"><h2>Estudios complementarios</h2><div class="card-body">
      <div class="grid2">
        <div class="field"><label>EKG</label><input id="ekg" oninput="render()"></div>
        <div class="field"><label>Rx tórax</label><input id="rx" oninput="render()"></div>
      </div>
      <div class="grid2" style="margin-top:6px">
        <div>
          <div style="font-size:11px;font-weight:700;color:var(--primary-dark);margin-bottom:4px">HEMATOLOGÍA</div>
          <div class="field"><label>WBC (xmm³)</label><input id="l_wbc" oninput="render()"></div>
          <div class="field"><label>Hemoglobina (g/dl)</label><input id="l_hb" oninput="calc()"></div>
          <div class="field"><label>Hematocrito (%)</label><input id="l_hto" oninput="render()"></div>
          <div class="field"><label>Plaquetas (xmm³)</label><input id="l_plt" oninput="render()"></div>
          <div class="field"><label>Neutrófilos (%)</label><input id="l_neu" oninput="render()"></div>
        </div>
        <div>
          <div style="font-size:11px;font-weight:700;color:var(--primary-dark);margin-bottom:4px">QUÍMICA</div>
          <div class="field"><label>Creatinina (mg/dl)</label><input id="l_cr" oninput="calc()"></div>
          <div class="field"><label>BUN (mg/dl)</label><input id="l_bun" oninput="render()"></div>
          <div class="field"><label>Glucosa (mg/dl)</label><input id="l_glu" oninput="render()"></div>
          <div class="field"><label>Sodio (mEq/l)</label><input id="l_na" oninput="render()"></div>
          <div class="field"><label>Potasio (mEq/l)</label><input id="l_k" oninput="render()"></div>
        </div>
      </div>
      <div class="grid3" style="margin-top:6px">
        <div class="field"><label>TP (seg)</label><input id="l_tp" oninput="render()"></div>
        <div class="field"><label>TPT (seg)</label><input id="l_tpt" oninput="render()"></div>
        <div class="field"><label>INR</label><input id="l_inr" oninput="render()"></div>
      </div>
    </div></div>

    <div class="card"><h2>Escalas de riesgo</h2>
      <div class="notectrl">
        <span class="nclabel">Incluir en la nota:</span>
        <select id="notePreset" onchange="setPreset(this.value)">
          <option value="solo_prio">Solo prioritarias</option>
          <option value="prio_opt">Prioritarias + opcionales</option>
          <option value="todas">Todas</option>
          <option value="custom">Personalizado</option>
        </select>
        <span class="nchint">o marque «nota» en cada escala</span>
        <button class="btn-mini" onclick="collapseIrrelevant()">Plegar no relevantes</button>
      </div>
      <div class="card-body" id="scoresBox"></div></div>

    <div class="card"><h2>Recomendaciones</h2><div class="card-body">
      <div style="font-size:11px;color:var(--muted);margin-bottom:6px">Sugeridas automáticamente según los scores:</div>
      <div id="recSuggest"></div>
      <div style="font-size:11px;color:var(--muted);margin:10px 0 4px">Banco (marque para incluir):</div>
      <div id="recBank"></div>
      <div class="field" style="margin-top:10px"><label>Observaciones adicionales (texto libre)</label>
        <textarea id="recFree" rows="4" oninput="render()"></textarea></div>
    </div></div>
  </div>

  <!-- ================= PREVIEW ================= -->
  <div class="preview-pane">
    <div class="preview-label">Vista previa de la nota</div>
    <div class="note" id="note"></div>
  </div>
</div>

<!-- ================= MODAL BIBLIOTECA ================= -->
<div class="modal-bg" id="libModal" onclick="if(event.target===this)closeLibrary()">
  <div class="modal">
    <div class="modal-head"><span>Pacientes guardados</span><button onclick="closeLibrary()" title="Cerrar">✕</button></div>
    <input class="modal-search" id="libSearch" placeholder="Buscar por nombre…" oninput="renderLibrary()">
    <div class="modal-list" id="libList"></div>
    <div class="modal-foot">
      <input type="file" id="importFile" accept=".json,application/json" style="display:none" onchange="importFileToLibrary(event)">
      <button class="btn btn-ghost dark" onclick="document.getElementById('importFile').click()">Importar archivo</button>
      <button class="btn btn-ghost dark" onclick="exportLibrary()">Respaldar biblioteca</button>
    </div>
  </div>
</div>

<script>
/* ================= CONFIG ================= */
