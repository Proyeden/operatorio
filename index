let presetMode="solo_prio";
function setPreset(mode){presetMode=mode;if(mode!=="custom")applyPreset();render();autosave();}
function applyPreset(){
  if(presetMode==="custom")return;
  SCORE_ORDER.forEach(name=>{
    const inc=document.getElementById("inc_"+name);if(!inc)return;
    const rel=relevance(name);
    inc.checked = presetMode==="todas" ? true
                : presetMode==="prio_opt" ? (rel!=="N")
                : (rel==="P");
  });
}
function onIncToggle(){presetMode="custom";const p=document.getElementById("notePreset");if(p)p.value="custom";render();autosave();}

/* ================= BORRADOR ACTUAL (autoguardado) ================= */
function collectData(){
  const d={fields:{},checks:{},preset:presetMode};
  document.querySelectorAll("#formPane input, #formPane select, #formPane textarea").forEach(e=>{
    if(!e.id)return;
    if(e.type==="checkbox")d.checks[e.id]=e.checked;
    else d.fields[e.id]=e.value;
  });
  return d;
}
function applyData(data){
  if(!data)return;
  for(const id in (data.fields||{})){const e=document.getElementById(id);if(e&&e.type!=="checkbox")e.value=data.fields[id];}
  for(const id in (data.checks||{})){const e=document.getElementById(id);if(e&&e.type==="checkbox")e.checked=data.checks[id];}
  if(data.preset){presetMode=data.preset;const p=document.getElementById("notePreset");if(p)p.value=data.preset;}
  calc();
}
function autosave(){try{localStorage.setItem("preop_current",JSON.stringify(collectData()));}catch(e){}}
let statusTimer=null;
function setStatus(msg){const s=document.getElementById("status");if(!s)return;s.textContent=msg;
  clearTimeout(statusTimer);statusTimer=setTimeout(()=>{s.textContent="";},2200);}
function newPatient(){
  if(confirm("¿Empezar una nota nueva? (Guarde antes el paciente actual si aún no lo ha hecho.)")){
    try{localStorage.removeItem("preop_current");}catch(e){}
