      let h="";
      if(def.selects){def.selects.forEach(s=>{
        h+=`<div class="rowsel"><label>${s.label}</label><select id="${s.id}" onchange="calc()">`;
        s.opts.forEach(o=>h+=`<option value="${o[1]}">${o[0]}</option>`);
        h+=`</select></div>`;
      });}
      const cando=def.wtype==="cando";
      def.items.forEach(it=>{
        const auto=it.auto?` class="check auto"`:` class="check"`;
        const autoflag=it.auto?`<span class="autoflag">auto</span>`:"";
        const ptlabel=cando?"":(it.pts>=0?"+"+it.pts:it.pts);
        h+=`<label${auto}><input type="checkbox" id="${it.id}" onchange="calc()">
          <span>${it.label}${autoflag}</span><span class="pts">${ptlabel}</span></label>`;
      });
      h+=`<div class="score-interp" id="interp_${name}"></div>`;
      body.innerHTML=h;
    }
    wrap.appendChild(body);
    box.appendChild(wrap);
  });
