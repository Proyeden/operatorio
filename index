/* ================= HELPERS ================= */
const val=id=>{const e=document.getElementById(id);return e?e.value.trim():"";};
const num=id=>{const v=parseFloat(val(id));return isNaN(v)?null:v;};
const chk=id=>{const e=document.getElementById(id);return e?e.checked:false;};
const setChk=(id,v)=>{const e=document.getElementById(id);if(e)e.checked=v;};
function pesoKg(){const p=num("peso");if(p===null)return null;return val("peso_u")==="lb"?p/2.2046:p;}
function imc(){const p=pesoKg(),t=num("talla");if(p===null||!t)return null;return p/Math.pow(t/100,2);}
function sct(){const p=pesoKg(),t=num("talla");if(p===null||!t)return null;return Math.sqrt(p*t/3600);}
function rt24(){const p=pesoKg();if(p===null)return null;let r=0;r+=Math.min(p,10)*100;if(p>10)r+=Math.min(p-10,10)*50;if(p>20)r+=(p-20)*20;return r;}

/* ================= AUTO FLAGS ================= */
function autoState(id){
  const edad=num("edad"), sexo=val("sexo"), cr=num("l_cr"), hb=num("l_hb"), bmi=imc(), tipo=val("tipo");
  switch(id){
    case "hirisk": return HIRISK.has(tipo);
    case "crea": return cr!==null && cr>2;
    case "age70": return edad!==null && edad>70;
    case "age50": return edad!==null && edad>50;
    case "male": return sexo==="Masculino";
    case "female": return sexo==="Femenino";
    case "imc25": return bmi!==null && bmi>25;
    case "imc35": return bmi!==null && bmi>35;
    case "anemia": return hb!==null && hb<=10;
    default: return false;
  }
}
function autoPts(id){
  const edad=num("edad");
  if(id==="ariscatAge"){if(edad===null)return 0;return edad>80?16:(edad>50?3:0);}
  if(id==="capriniAge"){if(edad===null)return 0;return edad>=75?3:(edad>=61?2:(edad>=41?1:0));}
  if(id==="charlsonAge"){if(edad===null)return 0;return Math.max(0,Math.floor((edad-40)/10));}
  return null;
}

/* ================= SCORE CALC ================= */
function scoreTotal(name){
  const def=SCORES[name];let tot=0;
  if(!def)return 0;
  if(def.selects)def.selects.forEach(s=>{tot+=parseInt(val(s.id)||0);});
  if(def.items)def.items.forEach(it=>{
    if(it.auto){
      const ap=autoPts(it.auto);
      if(ap!==null){tot+=ap;}                       // puntos por rango (edad)
      else if(autoState(it.auto)){tot+=it.pts;}      // binario auto
    } else if(chk(it.id)){tot+=it.pts;}
  });
  return tot;
}
function dasiMets(){const t=scoreTotal("DASI");return (0.43*t+9.6)/3.5;}

/* ---- interpretaciones ---- */
function interp(name){
  const t=scoreTotal(name);
  switch(name){
    case "RCRI":
      if(t<=0)return "Clase I · MACE 0.4-0.5% · riesgo muy bajo; sin estudios cardíacos adicionales.";
      if(t===1)return "Clase II · MACE ~1.3-2.6% · riesgo bajo-intermedio; optimización médica y valorar capacidad funcional.";
      if(t===2)return "Clase III · MACE ~4-7% · riesgo intermedio; considerar biomarcadores y valoración cardiológica.";
      return "Clase IV · MACE ≥9% · riesgo alto; optimización cardiológica y monitoreo perioperatorio.";
    case "Detsky":
      if(t<=15)return "Clase I · riesgo cardíaco bajo (<6%).";
      if(t<=30)return "Clase II · riesgo intermedio; valoración cardiológica previa.";
      return "Clase III · riesgo alto; optimización antes del procedimiento.";
    case "DASI":{const m=dasiMets();
      if(m>=10)return `${m.toFixed(1)} METs · capacidad funcional excelente; tolera bien el estrés quirúrgico.`;
      if(m>=4)return `${m.toFixed(1)} METs · capacidad adecuada (≥4); no requiere pruebas cardíacas por capacidad.`;
      return `${m.toFixed(1)} METs · capacidad limitada (<4); valorar pruebas si modifican la conducta.`;}
    case "ARISCAT":
      if(t<26)return "Riesgo pulmonar bajo (~1.6%); medidas estándar.";
      if(t<45)return "Riesgo pulmonar intermedio (~13%); espirometría incentiva, expansión pulmonar y movilización.";
      return "Riesgo pulmonar alto (~42%); ventilación protectora, fisioterapia respiratoria y vigilancia.";
    case "Caprini":{let lvl,prof;
      if(t===0){lvl="Riesgo muy bajo de TVP";prof="deambulación temprana.";}
      else if(t<=2){lvl="Riesgo bajo de TVP";prof="profilaxis mecánica (CNI/MECG).";}
      else if(t<=4){lvl="Riesgo moderado de TVP";prof="profilaxis mecánica ± farmacológica.";}
      else{lvl="Riesgo alto de TVP";prof="profilaxis farmacológica + mecánica.";}
      return `${lvl}; ${prof}`;}
    case "Wells":
      if(t>=3)return "Probabilidad ALTA de TVP; ecografía Doppler venosa.";
      if(t>=1)return "Probabilidad moderada; considerar dímero-D o ecografía.";
      return "Probabilidad baja de TVP.";
    case "STOP-BANG":
      if(t>=5)return "Riesgo alto de SAOS; precaución con opioides, oximetría postoperatoria, considerar CPAP.";
      if(t>=3)return "Riesgo intermedio de SAOS; vigilancia respiratoria postoperatoria.";
      return "Riesgo bajo de SAOS.";
    case "mFI-5":
      if(t===0)return "No frágil; buena reserva fisiológica.";
      if(t===1)return "Pre-frágil; vigilancia y optimización.";
      if(t===2)return "Frágil; prehabilitación y consentimiento reforzado.";
      return "Fragilidad grave; alto riesgo de complicaciones, estancia prolongada y egreso no rutinario.";
    case "CFS":{const v=parseInt(val("cfs_sel"));if(!v)return "Sin evaluar.";
      if(v<=3)return "No frágil; buena reserva.";
      if(v===4)return "Vulnerable; vigilancia.";
      return "Frágil; valoración geriátrica, optimización y consentimiento reforzado.";}
    case "Charlson":
      if(t===0)return "Sin comorbilidad relevante.";
      if(t<=2)return "Comorbilidad baja.";
      if(t<=4)return "Comorbilidad moderada; optimización médica.";
      return "Comorbilidad alta; impacto pronóstico, considerar nivel de cuidados postoperatorios.";
    case "Apfel":
      if(t<=1)return "Riesgo bajo de NVPO; profilaxis no rutinaria.";
      if(t===2)return "Riesgo moderado de NVPO; 1-2 antieméticos.";
      return "Riesgo alto de NVPO; profilaxis multimodal (2+ antieméticos de distinta clase).";
    case "ASA":{const a=val("asa_sel");const map={"ASA I":"Paciente sano.","ASA II":"Enfermedad sistémica leve, controlada.","ASA III":"Enfermedad sistémica grave, no incapacitante.","ASA IV":"Enfermedad sistémica grave con amenaza vital constante.","ASA V":"Moribundo; escasa probabilidad de sobrevivir sin cirugía.","ASA VI":"Muerte cerebral (donante de órganos)."};return map[a]||"Sin clasificar.";}
  }
  return "";
}
function scoreDisplay(name){ // puntaje mostrado
  if(name==="CFS"){const v=val("cfs_sel");return v?v:"—";}
  if(name==="ASA"){return val("asa_sel")||"—";}
  if(name==="DASI"){return dasiMets().toFixed(1);}
  return scoreTotal(name);
}
function relevance(name){
  const idx=TIPOS.indexOf(val("tipo"));if(idx<0)return "O";
  return (REL[name]||[])[idx]||"O";
}

