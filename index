  let restored=false;
  try{const saved=localStorage.getItem("preop_current");
    if(saved){applyData(JSON.parse(saved));restored=true;}
  }catch(e){}
  if(!restored){
    document.getElementById("fecha").value=new Date().toISOString().slice(0,10);
    applyPreset();
    calc();
  }
})();
