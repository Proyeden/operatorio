}

/* ================= BIBLIOTECA DE PACIENTES ================= */
const LIB_KEY="preop_library";
function getLibrary(){try{return JSON.parse(localStorage.getItem(LIB_KEY)||"[]");}catch(e){return [];}}
function setLibrary(l){try{localStorage.setItem(LIB_KEY,JSON.stringify(l));}catch(e){alert("No se pudo guardar (almacenamiento lleno o restringido).");}}
function slug(s){return (s||"").toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g,"").replace(/[^a-z0-9]+/g,"-").replace(/^-|-$/g,"");}

function saveToLibrary(){
  const nombre=val("nombre").trim();
  if(!nombre){alert("Escriba el nombre del paciente antes de guardar.");return;}
  const fechaEval=val("fecha")||new Date().toISOString().slice(0,10);
  const lib=getLibrary();
  const id=slug(nombre)+"__"+fechaEval;
  const rec={id,nombre,fechaEval,savedAt:new Date().toISOString(),data:collectData()};
  const idx=lib.findIndex(r=>r.id===id);
  if(idx>=0){
    if(!confirm("Ya existe una valoración de «"+nombre+"» con fecha "+fechaEval+". ¿Actualizarla?\n\n(Para conservar la anterior y crear una nueva —p. ej. control al año siguiente— cambie primero la Fecha.)"))return;
    lib[idx]=rec;
  } else lib.push(rec);
  setLibrary(lib);
  setStatus("Paciente guardado ✓");
}
function fmtDate(iso){try{return new Date(iso).toLocaleString("es-GT",{year:"numeric",month:"short",day:"numeric",hour:"2-digit",minute:"2-digit"});}catch(e){return iso;}}

function openLibraryModal(){document.getElementById("libModal").classList.add("open");document.getElementById("libSearch").value="";renderLibrary();}
function closeLibrary(){document.getElementById("libModal").classList.remove("open");}
function renderLibrary(){
  const q=slug(document.getElementById("libSearch").value);
  let lib=getLibrary().sort((a,b)=> (b.savedAt||"").localeCompare(a.savedAt||""));
  if(q)lib=lib.filter(r=>slug(r.nombre).includes(q));
  const box=document.getElementById("libList");
  if(!lib.length){box.innerHTML=`<div class="lib-empty">No hay pacientes guardados${q?" con ese nombre":""}.</div>`;return;}
  box.innerHTML=lib.map(r=>`<div class="lib-row">
    <div class="lib-info"><div class="lib-name">${esc(r.nombre)}</div>
      <div class="lib-meta">Valoración: ${esc(r.fechaEval||"—")} · guardado ${fmtDate(r.savedAt)}</div></div>
    <div class="lib-actions">
      <button class="lib-open" onclick="loadRecord('${r.id}')">Abrir</button>
      <button class="lib-del" onclick="deleteRecord('${r.id}')">Borrar</button>
    </div></div>`).join("");
}
function loadRecord(id){
  const rec=getLibrary().find(r=>r.id===id);if(!rec)return;
  applyData(rec.data);closeLibrary();setStatus("Paciente cargado");
}
function deleteRecord(id){
  if(!confirm("¿Borrar esta valoración guardada? Esta acción no se puede deshacer."))return;
  setLibrary(getLibrary().filter(r=>r.id!==id));renderLibrary();
}
function exportLibrary(){
  const lib=getLibrary();
  if(!lib.length){alert("No hay pacientes para respaldar.");return;}
  const blob=new Blob([JSON.stringify({library:lib,exported:new Date().toISOString()},null,2)],{type:"application/json"});
  const url=URL.createObjectURL(blob);const a=document.createElement("a");
  a.href=url;a.download="Biblioteca_preop_"+new Date().toISOString().slice(0,10)+".json";
  document.body.appendChild(a);a.click();document.body.removeChild(a);
  setTimeout(()=>URL.revokeObjectURL(url),1000);setStatus("Biblioteca respaldada");
}
function importFileToLibrary(ev){
  const f=ev.target.files[0];if(!f)return;
  const r=new FileReader();
  r.onload=()=>{
    try{
      const obj=JSON.parse(r.result);
      const lib=getLibrary();
      if(obj.library && Array.isArray(obj.library)){
        // respaldo de biblioteca completa: fusionar
        obj.library.forEach(rec=>{const i=lib.findIndex(x=>x.id===rec.id);if(i>=0)lib[i]=rec;else lib.push(rec);});
        setLibrary(lib);renderLibrary();setStatus("Biblioteca importada ("+obj.library.length+")");
      } else if(obj.fields){
        // borrador individual (p. ej. del Google Form): cargar como paciente actual
        applyData(obj);closeLibrary();setStatus("Datos importados");
      } else {alert("El archivo no tiene un formato reconocido.");}
    }catch(e){alert("El archivo no es válido.");}
  };
  r.readAsText(f);ev.target.value="";
}

